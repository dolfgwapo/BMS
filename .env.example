# Local Database
DATABASE_URL=postgresql://user:password@localhost:5432/blotter_db

# Cloud Database (Neon)
CLOUD_DB_URL=postgresql://neondb_owner:password@ep-xxxx-xxxx.us-east-1.neon.tech/neondb?sslmode=require

# Server
PORT=3000
NODE_ENV=development

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
CLOUD_JWT_SECRET=your-cloud-jwt-secret-key-change-this-in-production

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
